    },
    {
      "id": "claim_e2ac3f2fd97c41e081eacc577fb95f5d",
      "statement": "The system prompt directs the model to use only source-resume facts, preserve dates and titles, ignore instructions embedded in the untrusted job description, and return only unfenced Markdown beginning with the candidate name as H1; these constraints are prompt-level because the route does not programmatically validate generated claims.",
      "evidence": [
        {
          "resource": "repo://apps/web/app/api/resume/tailor/route.ts#L10-L21",
          "version": "repo-lines-v1:sha256:31b3ea675aafb9274ea7075c4054061c1fefdd8d4ab0edc4486afb51fcbf05dc:"
