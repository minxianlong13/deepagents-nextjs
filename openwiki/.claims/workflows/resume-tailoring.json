    {
      "id": "claim_f59d45adf8f249859870f1d6f045b53d",
      "statement": "The API normalizes either string content or text-bearing content blocks into Markdown, rejects an empty normalized response, returns `{ markdown }` on success, and maps caught errors to HTTP 500 with an Error message when available.",
