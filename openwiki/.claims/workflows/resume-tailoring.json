        }
      ]
    },
    {
      "id": "claim_b9dd32213cc641c9aa64c3ca6c29ab49",
      "statement": "The handler calls `claude-sonnet-4-6` at temperature 0 and supplies the serialized static profile under `SOURCE_RESUME` separately from the user-supplied `JOB_DESCRIPTION`.",
      "evidence": [
        {
          "resource": "repo://apps/web/app/api/resume/tailor/route.ts#L61-L71",
