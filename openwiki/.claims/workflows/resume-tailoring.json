  "claims": [
    {
      "id": "claim_701ef77c1eb142879f1e160c9ee0e4fc",
      "statement": "The active resume-tailoring workflow is a stateless direct path: the `/resume` client posts `jobDescription` to `POST /api/resume/tailor`, which directly invokes Anthropic with the bundled `candidateProfile`; it does not use the RAG/MCP path or Prisma persistence.",
      "evidence": [
        {
          "resource": "repo://apps/web/app/api/resume/tailor/route.ts#L47-L78",
          "version": "repo-lines-v1:sha256:46f5fb8fa30639c27676fcaa6e0886970a36d6b39a48e29bcdf34ad3fd578d62:"
        },
        {
          "resource": "repo://apps/web/app/resume/page.tsx#L20-L53",
          "version": "repo-lines-v1:sha256:6a62d52992f9ff016b46643f1c02ccde21193586c875d4402345eb47f206b7be:"
        },
        {
          "resource": "repo://apps/web/lib/resume/candidate-profile.ts#L1-L9",
          "version": "repo-lines-v1:sha256:6210ee6198f9ba0b20476c99a6a5bc65d3a6f921f59c1f2832ce869658bbe107:"
        }
      ]
    },
    {
      "id": "claim_bc842de8283f4e9abe5127a60bed741a",
      "statement": "The browser disables tailoring while loading or until the trimmed job description reaches 50 characters, caps textarea input at 30,000 characters, and sends JSON to the tailoring endpoint; it holds the returned Markdown and errors only in client component state.",
      "evidence": [
        {
          "resource": "repo://apps/web/app/resume/page.tsx#L107-L135",
          "version": "repo-lines-v1:sha256:a42ff2ebc12171af3963c272e9b732e8c09a8309dea484dce4ead02d056c4327:"
        },
        {
          "resource": "repo://apps/web/app/resume/page.tsx#L11-L53",
          "version": "repo-lines-v1:sha256:994a75b0e7c711b28419a644aef62f0efb71be6238fba1ddd61a4929ad8cf960:"
        }
      ]
    },
    {
      "id": "claim_122d2ae9527d4cb680b9aa694ad53956",
      "statement": "The API independently validates a trimmed string job description between 50 and 30,000 characters and returns HTTP 400 for a parsed payload that fails this schema, preventing direct callers from bypassing the UI input limits.",
      "evidence": [
        {
          "resource": "repo://apps/web/app/api/resume/tailor/route.ts#L47-L59",
          "version": "repo-lines-v1:sha256:70cfc99020d8652173386eedd2807dc84bcc37dacf7e43a3c9df1c81de0f4397:"
