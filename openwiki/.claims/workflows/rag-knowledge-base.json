    {
      "id": "claim_a0a2660516024f108c76933d8959de6f",
      "statement": "Retrieved documentation is explicitly treated as untrusted reference data by both the coordinator and chunk analyst instructions, which direct the analyst to read its assigned file and include the source URL in a concise summary.",
