    {
      "id": "claim_21472b3375e14a688d01db51fa95ef6e",
      "statement": "The RAG Deep Agent combines MCP-discovered tools and `document_search`, uses the shared retrieval-file backend, and is instructed to delegate one retrieved chunk path per `chunk-analyst` task with at most three parallel analysts before synthesizing a sourced answer.",
